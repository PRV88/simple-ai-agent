__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Virtual environments
.venv/
venv/
ENV/
env/

# Node & Next.js Frontend
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.turbo/
frontend/.turbo/

# Logs & Temporary files
logs/
reports/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System & IDEs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
